      "format": "mcq",
      "instruction": "one-false",
      "stem": "Parmi ces propositions laquelle ne permet pas de déterminer l’étiologie du syndrome de Cushing :",
      "labs": [],
      "options": [
        {
          "id": "A",
          "text": "IRM hypophyse",
          "explanation": "Utile pour la cause."
        },
        {
          "id": "B",
          "text": "La concentartion plamsatique d’ACTH",
          "explanation": "Utile : premier examen étiologique."
        },
        {
          "id": "C",
          "text": "Le test de stimulation de CRH",
          "explanation": "Utile : distingue l’origine hypophysaire de l’origine ectopique."
        },
