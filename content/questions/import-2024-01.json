      "instruction": "one-true",
      "stem": "vraie sur la thyroïde",
      "labs": [],
      "options": [
        {
          "id": "A",
          "text": "Le cancer folliculaire est le plus fréquent",
          "explanation": "Faux : c’est le papillaire."
        },
        {
          "id": "B",
          "text": "Le cancer à cellules de Hurthle touche les enfants/jeunes",
          "explanation": "Faux : plutôt l’adulte plus âgé."
        },
        {
          "id": "C",
          "text": "La dissémination du cancer papillaire se fait par voie hématogène",
          "explanation": "Faux : voie lymphatique (c’est le folliculaire qui est hématogène)."
        },
        {
          "id": "D",
          "text": "Des taux élevés de calcitonine et de CEA dans le CMT",
          "explanation": "Vrai (réponse attendue)."
        },
        {
          "id": "E",
          "text": "Le cancer thyroïdien anaplasique répond bien à l’iode à fortes doses",
          "explanation": "Faux : il ne capte pas l’iode ; pronostic très sombre."
        }
      ],
      "expected": [
