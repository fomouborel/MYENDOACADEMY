      "stem": "Taux plasmatique abaissé de TSH, une cause impossible",
      "labs": [],
      "options": [
        {
          "id": "A",
          "text": "goitre multinudulaire toxique",
          "explanation": "Possible : excès d’hormones, TSH freinée."
        },
        {
          "id": "B",
          "text": "premier trimestre de grossesse",
          "explanation": "Possible : l’hCG stimule le récepteur de la TSH."
        },
        {
          "id": "C",
          "text": "Hormone thyroidienne pour hypothyroide",
          "explanation": "Possible : surtout en cas de surdosage."
        },
        {
          "id": "D",
          "text": "prise d’amiodarone",
          "explanation": "Possible : hyperthyroïdie induite (type 1 ou 2)."
        },
        {
