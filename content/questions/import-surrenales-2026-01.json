      "format": "mcq",
      "instruction": "one-correct",
      "stem": "On découvre une tumeur surrénalienne de 2 cm chez un patient hypertendu de 50 ans. Parmi ces hypothèses, laquelle est la moins probable ?",
      "labs": [],
      "options": [
        {
          "id": "A",
          "text": "adénome corticosurrénalien bénin non-sécrétant",
          "explanation": "Probable : le plus fréquent."
        },
        {
          "id": "B",
          "text": "Phéochromocytome",
          "explanation": "Possible."
        },
        {
          "id": "C",
          "text": "hyperaldostéronisme primaire",
          "explanation": "Possible : patient hypertendu."
        },
        {
          "id": "D",
          "text": "Cushing",
          "explanation": "Possible."
        },
        {
          "id": "E",
          "text": "Addison",
          "explanation": "La moins probable (réponse attendue)."
        }
