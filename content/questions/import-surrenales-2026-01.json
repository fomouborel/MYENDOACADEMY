          "text": "Test à la dexaméthasone",
          "explanation": "Non : explore le freinage."
        },
        {
          "id": "C",
          "text": "Dosage de l’ACTH à 8h",
          "explanation": "Non : un dosage du matin ne renseigne pas sur le rythme."
        },
        {
          "id": "D",
          "text": "Dosage de l’ACTH + cortisol à 8h",
          "explanation": "Non : même raison."
        },
        {
          "id": "E",
          "text": "Cortisolurie de 24h",
          "explanation": "Non : production totale sur 24 h, pas le rythme."
