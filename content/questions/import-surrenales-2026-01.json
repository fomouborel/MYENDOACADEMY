      "stem": "Quel test effectuer en ambulatoire pour évaluer le rythme circadien dans un syndrome de Cushing ?",
      "labs": [],
      "options": [
        {
          "id": "A",
          "text": "Test salivaire",
          "explanation": "Oui (réponse attendue)."
        },
        {
